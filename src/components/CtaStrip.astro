---
import { toLang } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import Icon from '@/components/Icon.astro';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="ctastrip" aria-label={t.cta.stripText}>
  <div class="sheet gutter-x ctastrip__inner">
    <p class="font-display ctastrip__text reveal">{t.cta.stripText}</p>
    <a href="#contact" class="btn btn--accent ctastrip__btn reveal" style="--reveal-delay:80ms">
      {t.cta.stripButton}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</section>

<style>
  .ctastrip {
    border-block: 1px solid var(--ink);
    background: var(--paper-sunk);
  }
  .ctastrip__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
  }
  .ctastrip__text {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.4rem, 1rem + 1.8vw, 2.4rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ctastrip__btn {
    flex: 0 0 auto;
  }
</style>
