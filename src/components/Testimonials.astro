---
import { toLang } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import { getTestimonials } from '@/data/testimonials';
import Icon from '@/components/Icon.astro';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const items = getTestimonials(lang);
---

{
  items.length > 0 && (
    <section id="reviews" class="reviews py-section">
      <div class="sheet gutter-x">
        <div class="reviews__head reveal">
          <span class="reg font-mono">04.5</span>
          <span class="kicker">{t.testimonials.kicker}</span>
        </div>

        <ul class="reviews__list">
          {items.map((tm, i) => (
            <li class="quote reveal" style={`--reveal-delay:${i * 80}ms`}>
              <Icon name="asterisk" size={18} class="quote__mark" />
              <blockquote class="quote__text text-pretty">{tm.quote}</blockquote>
              <figcaption class="quote__by font-mono">
                <span class="quote__author">{tm.author}</span>
                <span class="quote__company">{[tm.role, tm.company].filter(Boolean).join(' · ')}</span>
              </figcaption>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .reviews__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.5rem;
  }
  .reviews__list {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .quote {
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--rule);
  }
  .quote__mark {
    color: var(--oxblood);
    margin-bottom: 1.1rem;
  }
  .quote__text {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.7rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .quote__by {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 1.25rem;
  }
  .quote__author {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .quote__company {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .reviews__list {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(2rem, 5vw, 4rem);
    }
  }
</style>
