---
import { getEducation } from '@/data/education';
import { toLang } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const education = getEducation(lang);
---

<section id="education" class="edu py-section">
  <div class="sheet gutter-x">
    <div class="edu__head reveal">
      <span class="reg font-mono">05.5</span>
      <span class="kicker">{t.education.head}</span>
    </div>

    <ul class="edu__list">
      {
        education.map((item, i) => (
          <li class="edu__item reveal" style={`--reveal-delay:${i * 70}ms`}>
            <div class="edu__top">
              <span class="font-mono edu__idx">{item.index}</span>
              <span class="edu__status">
                {item.status}
                {item.note && <span class="edu__note font-mono"> · {item.note}</span>}
              </span>
            </div>
            <h3 class="font-display edu__program">{item.program}</h3>
            <p class="font-mono edu__inst">{item.institution}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .edu {
    padding-top: 0;
  }
  .edu__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.5rem;
  }
  .edu__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .edu__item {
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--rule);
  }
  .edu__item:first-child {
    border-top: 0;
  }
  .edu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .edu__idx {
    color: var(--oxblood);
    font-size: 0.85rem;
  }
  .edu__program {
    font-stretch: 110%;
    font-weight: 700;
    font-size: clamp(1.3rem, 1rem + 1.3vw, 1.9rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .edu__inst {
    margin: 0.65rem 0 0;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .edu__list {
      grid-template-columns: 1fr 1fr;
    }
    .edu__item {
      border-top: 0;
      padding-inline: clamp(0rem, 3vw, 2.5rem);
    }
    .edu__item:first-child {
      padding-left: 0;
      border-right: 1px solid var(--rule);
    }
    .edu__item:last-child {
      padding-right: 0;
    }
  }
</style>
