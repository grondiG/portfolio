---
import { getCategories, STACK_TOOLS_TOTAL, STACK_GROUPS_TOTAL } from '@/data/stack';
import { toLang } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import SectionHeader from '@/components/SectionHeader.astro';

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const categories = getCategories(lang);
---

<section id="stack" class="section py-section stack">
  <div class="sheet gutter-x">
    <SectionHeader
      index="03"
      kicker={t.stack.kicker}
      title={t.stack.title}
      note={t.stack.note(STACK_TOOLS_TOTAL, STACK_GROUPS_TOTAL)}
    />

    <div class="stack__list">
      {
        categories.map((cat, i) => (
          <div class="row reveal" style={`--reveal-delay:${i * 55}ms`}>
            <div class="row__head">
              <span class="reg font-mono row__idx">{cat.index}</span>
              <h3 class="font-display row__label">{cat.label}</h3>
            </div>
            <ul class="row__items">
              {cat.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack__list {
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 2rem;
    padding-block: clamp(1.25rem, 3vw, 1.9rem);
    border-top: 1px solid var(--rule);
  }
  .row__head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  .row__idx {
    font-size: 0.78rem;
  }
  .row__label {
    font-stretch: 110%;
    font-weight: 700;
    font-size: clamp(1.3rem, 1rem + 1.2vw, 1.85rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0;
  }
  .row__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row .tag {
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .row .tag:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  @media (min-width: 64rem) {
    .row {
      grid-template-columns: minmax(13rem, 18rem) 1fr;
      align-items: center;
      gap: 2.5rem;
    }
  }
</style>
