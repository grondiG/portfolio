---
interface Props {
  index: string;
  kicker: string;
  title: string;
  note?: string;
}
const { index, kicker, title, note } = Astro.props;
---

<header class="sec">
  <div class="sec__lead reveal">
    <span class="reg font-mono sec__idx">{index}</span>
    <span class="kicker sec__kicker">{kicker}</span>
  </div>
  <div class="sec__row">
    <h2 class="font-display sec__title reveal" style="--reveal-delay:60ms">{title}</h2>
    {note && <span class="font-mono sec__note reveal" style="--reveal-delay:120ms">{note}</span>}
  </div>
</header>

<style>
  .sec {
    padding-bottom: clamp(1.75rem, 4vw, 3rem);
  }
  .sec__lead {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 0.9rem;
  }
  .sec__idx {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }
  .sec__kicker {
    color: var(--ink-muted);
  }
  .sec__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--ink);
    padding-top: clamp(1rem, 2.5vw, 1.75rem);
  }
  .sec__title {
    flex: 1 1 auto;
    min-width: 0;
    font-stretch: 125%;
    font-weight: 800;
    font-size: theme('fontSize.h1[0]');
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin: 0;
  }
  .sec__note {
    flex: 0 0 auto;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-bottom: 0.4rem;
  }
</style>
