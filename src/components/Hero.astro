---
import { getSite } from '@/data/site';
import { PROJECT_COUNT } from '@/data/projects';
import { toLang } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';
import Icon from '@/components/Icon.astro';

const lang = toLang(Astro.currentLocale);
const site = getSite(lang);
const t = useTranslations(lang);
const liveCount = String(PROJECT_COUNT).padStart(2, '0');
---

<section id="top" class="hero">
  <div class="sheet">
    <!-- Technical metadata strip — slides as a marquee on mobile -->
    <div class="hero__meta">
      <div class="hero__meta-track">
        <div class="hero__meta-set">
          <span class="font-mono hero__meta-id">{site.name} — {site.role} — Est. {site.experience.since}</span>
          <span class="font-mono hero__coords">
            <Icon name="pin" size={12} />
            {site.location.coordinates.lat} / {site.location.coordinates.lng}
          </span>
        </div>
        <div class="hero__meta-set" aria-hidden="true">
          <span class="font-mono hero__meta-id">{site.name} — {site.role} — Est. {site.experience.since}</span>
          <span class="font-mono hero__coords">
            <Icon name="pin" size={12} />
            {site.location.coordinates.lat} / {site.location.coordinates.lng}
          </span>
        </div>
      </div>
    </div>

    <!-- Masthead — spans the full sheet -->
    <div class="gutter-x hero__band">
      <h1 class="font-display hero__title">
        <span class="hero__line reveal">Full<span class="hero__dash">—</span>Stack</span>
        <span class="hero__line reveal" style="--reveal-delay:90ms">
          Developer<span class="hero__cursor" aria-hidden="true"></span>
        </span>
      </h1>
    </div>

    <!-- Chips + profile aside -->
    <div class="gutter-x hero__bottom">
      <ul class="hero__chips reveal" style="--reveal-delay:160ms" aria-label="Primary stack">
        {site.roleStack.map((tech) => <li class="tag">{tech}</li>)}
        <li class="tag">AWS</li>
        <li class="tag">TypeScript</li>
      </ul>

      <aside class="hero__aside reveal" style="--reveal-delay:220ms">
        <p class="kicker hero__aside-kicker">/ {t.hero.profile}</p>
        <p class="hero__lede text-pretty">{site.tagline}</p>
        <div class="hero__cta">
          <a href="#work" class="btn">
            {t.hero.selectedWork}
            <Icon name="arrow-down" size={15} />
          </a>
          <a href="#contact" class="link">
            {t.hero.getInTouch}
            <Icon name="arrow-up-right" size={15} />
          </a>
        </div>
      </aside>
    </div>

    <!-- Foot ticker — slides as a marquee on mobile -->
    <div class="hero__foot font-mono">
      <div class="hero__foot-track">
        <div class="hero__foot-set">
          <span class="hero__foot-item">
            <Icon name="dot" size={9} class="hero__live" />
            {site.status.label}
          </span>
          <span class="hero__foot-item hero__foot-num">{t.hero.projectsLive(liveCount)}</span>
          <a href="#profile" class="hero__foot-item hero__scroll">
            <Icon name="arrow-down" size={13} /> {t.hero.scroll}
          </a>
          <span class="hero__foot-item">{site.location.city}, {site.location.countryCode}</span>
        </div>
        <div class="hero__foot-set" aria-hidden="true">
          <span class="hero__foot-item">
            <Icon name="dot" size={9} class="hero__live" />
            {site.status.label}
          </span>
          <span class="hero__foot-item hero__foot-num">{t.hero.projectsLive(liveCount)}</span>
          <a href="#profile" class="hero__foot-item hero__scroll" tabindex="-1">
            <Icon name="arrow-down" size={13} /> {t.hero.scroll}
          </a>
          <span class="hero__foot-item">{site.location.city}, {site.location.countryCode}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
    padding-top: calc(var(--header-h) + clamp(1.75rem, 5vw, 3.5rem));
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  /* ---- Metadata bands ----------------------------------------------------
     Base layout is static (desktop / reduced-motion / no-JS safe): one set,
     spaced across the gutters. The media query lower down upgrades each band
     to a sliding marquee on motion-friendly phones so the whole strip is
     revealed by sliding instead of wrapping. */
  .hero__meta,
  .hero__foot {
    font-size: 0.66rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-inline: theme('spacing.gutter');
  }
  .hero__meta {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .hero__meta-track,
  .hero__foot-track {
    display: flex;
    width: 100%;
  }
  .hero__meta-set,
  .hero__foot-set {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
  }
  .hero__meta-set {
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .hero__meta-set[aria-hidden],
  .hero__foot-set[aria-hidden] {
    display: none;
  }
  .hero__coords {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__band {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .hero__title {
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(2.1rem, -0.4rem + 10.4vw, 9rem);
    line-height: 0.84;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    margin: 0;
  }
  .hero__line {
    display: block;
    white-space: nowrap;
  }
  .hero__dash {
    color: var(--oxblood);
  }
  .hero__cursor {
    display: inline-block;
    width: 0.14em;
    height: 0.8em;
    margin-left: 0.1em;
    background: var(--oxblood);
    vertical-align: baseline;
    transform: translateY(0.02em);
    animation: blink 1.15s steps(1, end) infinite;
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    padding-top: clamp(1.75rem, 4vw, 2.75rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__aside-kicker {
    margin-bottom: 0.9rem;
  }
  .hero__lede {
    max-width: 42ch;
    font-size: theme('fontSize.lede[0]');
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
    margin-top: 1.6rem;
  }

  .hero__foot {
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .hero__foot-set {
    gap: 0.6rem 2rem;
  }
  .hero__foot-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__foot-num {
    color: var(--ink);
  }
  .hero__live {
    color: var(--oxblood);
    animation: blink 1.6s steps(1, end) infinite;
  }
  .hero__scroll {
    color: var(--ink);
    transition: color 0.25s ease;
  }
  .hero__scroll:hover {
    color: var(--oxblood);
  }

  /* ---- Mobile: slide the metadata bands as marquees ----------------------
     Only on phones, and only when motion is welcome. Each band becomes a
     single non-wrapping line that scrolls continuously; the duplicate set
     (aria-hidden) makes the loop seamless. Press-and-hold pauses it. */
  @media (max-width: 47.99rem) and (prefers-reduced-motion: no-preference) {
    .hero__meta,
    .hero__foot {
      overflow: hidden;
      padding-inline: 0;
    }
    .hero__meta-track,
    .hero__foot-track {
      width: max-content;
      will-change: transform;
    }
    .hero__meta-track {
      animation: marquee 22s linear infinite;
    }
    .hero__foot-track {
      animation: marquee 26s linear infinite;
    }
    .hero__meta:active .hero__meta-track,
    .hero__foot:active .hero__foot-track {
      animation-play-state: paused;
    }
    .hero__meta-set,
    .hero__foot-set {
      flex: 0 0 auto;
      flex-wrap: nowrap;
      justify-content: flex-start;
      white-space: nowrap;
      gap: 1.5rem;
      padding-inline: 0.9rem 1.5rem;
    }
    .hero__meta-set[aria-hidden],
    .hero__foot-set[aria-hidden] {
      display: flex;
    }
  }

  @media (min-width: 64rem) {
    .hero__bottom {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 30rem);
      align-items: start;
      gap: clamp(2.5rem, 5vw, 5rem);
    }
    .hero__chips {
      padding-top: 0.4rem;
    }
  }
</style>
